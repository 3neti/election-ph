{
    "name": "3neti/election-ph",
    "description": "Philippine election profile and registry builder for election ceremonies",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-pdo_sqlite": "*",
        "3neti/election-ceremonies": "^0.3"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "LBHurtado\\ElectionPh\\": "src/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
